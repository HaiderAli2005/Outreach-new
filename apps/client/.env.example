# Where the Next.js server proxies /api/* in development or when not behind the load balancer
API_ORIGIN=http://localhost:4000
# Server-side base URL used by server components (the landing page's plan fetch)
INTERNAL_API_URL=http://localhost:4000
# Set to "off" when the load balancer routes /api/* to the API service directly
API_PROXY=on
# Optional: free Brandfetch client ID (brandfetch.com/developers) for company suggestions in the domain box
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
