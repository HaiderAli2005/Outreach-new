# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public origins (comma separated) allowed by CORS; the web app origin in production
WEB_ORIGIN=http://localhost:3100
# Public base URL of the API as reached by third parties (webhook URLs are built from it)
PUBLIC_API_URL=http://localhost:4000

# ── Data stores ───────────────────────────────────────────
DATABASE_URL=postgresql://aperture:aperture@localhost:55432/aperture?schema=public&connection_limit=10
# Optional. When unset, job locks use Postgres advisory locks and rate limits use memory.
REDIS_URL=redis://localhost:6379

# ── Secrets (Secret Manager in production) ────────────────
# 32+ random bytes each, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
# 32 bytes, base64 encoded: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Shared secret Cloud Scheduler sends in X-Jobs-Secret
JOBS_SECRET=change-me-jobs-secret
# Shared secret appended to Calendly / Apollo webhook URLs (?token=). Also signs unsubscribe links.
WEBHOOK_SECRET=change-me-webhook-secret
# HMAC key for the one-click batch approval links
APPROVE_LINK_SECRET=change-me-approve-secret

# ── Google OAuth 2.0 (optional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty: Google sends people back to WEB_ORIGIN/api/v1/auth/oauth/google/callback (add that exact URL in Google Cloud).
GOOGLE_REDIRECT_URI=

# ── Stripe (optional; billing returns 503 when unset) ─────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Customers prepay credits (top-ups of $25 to $500). No Stripe prices or subscriptions are needed.

# ── Email through Mailgun SMTP (optional) ──────────────
# When all four of MAIL_HOST, MAIL_USER, MAIL_PASS and MAIL_FROM are set, new accounts confirm their
# email with number match and "Forgot password" works. When any is empty, sign up works without it.
# EU Mailgun accounts use smtp.eu.mailgun.org.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ── AI (optional; analysis, drafts and personalization need it) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The business analysis and sample emails, best model first. Skipped automatically if your account doesn't have it.
OPENAI_ANALYSIS_MODEL=gpt-6-luna,gpt-4.1

# ── Platform-level integration keys (used when a tenant has not set its own) ──
APOLLO_API_KEY=
MILLIONVERIFIER_API_KEY=
SLACK_WEBHOOK_URL=

# ── Onboarding analysis ─────────────────────────────────
# Live progress stream for the business analysis. Set to false to use the old single request.
ANALYSIS_STREAM=true
# One organisation-level count per audience for a true company total. Costs 1 Apollo credit per audience.
ACCURATE_COMPANY_COUNT=false

# ── Shared sending pool ─────────────────────────────────
# Domains and mailboxes are bought by you (any registrar, any mail host) and added on the admin Domains page.
# Share of the pool's daily capacity kept for paying customers before our own internal outreach may use it.
POOL_CUSTOMER_RESERVE=0.2
# Runs every background job inside the API on its own schedule (sending, reading mailboxes, warmup, reports).
# On by default in development, where there is no Cloud Scheduler. Leave off in production.
RUN_JOBS_IN_PROCESS=
# Instant replies: one IMAP IDLE connection per sending mailbox, so a reply shows in seconds, not at the 2-minute poll.
# On by default in development (inside the API). In production run `npm run watcher` as its own always-on process
# and leave this off on the API. MAILBOX_WATCH_MAX caps the mailboxes one process holds open; MAILBOX_WATCH_SHARD
# ("0/2", "1/2") splits the pool across several watcher processes. Set REDIS_URL so a separate watcher can wake the
# live inbox on every API instance; without it the inbox still updates within 5 seconds.
MAILBOX_WATCH=
MAILBOX_WATCH_MAX=300
MAILBOX_WATCH_SHARD=

# ── Our own sending engine (SMTP out, IMAP in) ──────────────
# Where mailbox passwords live. Never in Postgres. "gcp" = Google Secret Manager (required in production),
# "file" = encrypted with ENCRYPTION_KEY in SECRETS_FILE (local development only).
SECRET_STORE=file
SECRETS_FILE=.secrets/mailboxes.json
GCP_PROJECT_ID=
# The daily DKIM seed test: a mailbox we control on another provider (e.g. Gmail, with an app password). Its password
# goes in the secret store under the key "seed" (Secret Manager name: aperture-seed), never here.
# Without it a new pool domain stays WARMING (it still sends, 30 a mailbox a day); warmed domains don't need it.
SEED_MAILBOX_ADDRESS=
SEED_IMAP_HOST=imap.gmail.com
SEED_IMAP_PORT=993

# ── Email-finding waterfall (after Apollo) ──────────────────
# Finders tried in order when Apollo has no address, stopping at the first verified hit. A finder is only ever
# called once its resale permission is confirmed in src/integrations/finders.ts (it is not yet for anymailfinder).
FINDER_WATERFALL=
ANYMAILFINDER_API_KEY=
